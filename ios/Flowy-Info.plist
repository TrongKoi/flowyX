<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Phan Info.plist khong dat duoc bang build setting INFOPLIST_KEY_*.
    Xcode GOP file nay voi phan tu sinh (GENERATE_INFOPLIST_FILE = YES).

    Nam NGOAI thu muc Flowy/ co chu dich: thu muc do la "synchronized
    group", moi file trong do tu thanh tai nguyen - Info.plist ma nam trong
    do se bi copy hai lan va build loi.
-->
<plist version="1.0">
<dict>
    <!-- Laptop chay HTTP trong mang LAN khi TEST va DEMO. Ban phat hanh
         chay tren may se bo hai khoa nay. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Flowy kết nối tới laptop trong cùng mạng WiFi khi chạy thử và demo.</string>
    <key>UIAppFonts</key>
    <array>
        <string>Lexend-Regular.ttf</string>
        <string>Lexend-SemiBold.ttf</string>
        <string>Andika-Regular.ttf</string>
        <string>Andika-Bold.ttf</string>
        <string>Inter-Regular.ttf</string>
        <string>Inter-SemiBold.ttf</string>
    </array>
</dict>
</plist>
