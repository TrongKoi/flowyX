<?xml version="1.0" encoding="utf-8"?>
<!-- Chip muc nhac. Dang chon = nen nhan nhat + vien nhan. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nhan_nhat" />
            <stroke android:width="2dp" android:color="@color/nhan" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/the" />
            <stroke android:width="1dp" android:color="@color/vien" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
