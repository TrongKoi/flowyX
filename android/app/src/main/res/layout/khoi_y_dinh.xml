<?xml version="1.0" encoding="utf-8"?>
<!--
    Y DINH THUC THI: ba o viec gi / khi nao / o dau.

    O trong hien dau gach, KHONG co lai - layout khong bao gio doi hinh
    dang (UIUX_QUYET_DINH cau 3, "vi tri thong tin").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Flowy.The"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Flowy.NhanKhoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/khoi_y_dinh" />

        <Button
            android:id="@+id/nut_viec_moi"
            style="@style/Flowy.NutChu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viec_moi" />
    </LinearLayout>

    <TextView
        android:id="@+id/y_viec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/chu"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/y_khi_dau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/chu_phu"
        android:textSize="15sp" />
</LinearLayout>
