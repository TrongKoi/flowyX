<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_ngay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityHeading="true"
        android:textColor="@color/chu"
        android:textSize="@dimen/chu_cau_hoi"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_tom_tat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/chu_phu"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/cuon_ngay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/dong_thoi_gian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/nut_them"
        style="@style/Flowy.NutChinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/them_ke_hoach" />
</LinearLayout>
