<?xml version="1.0" encoding="utf-8"?>
<!--
    MAN HINH CHINH - DIEN THOAI (giao dien v2, huong C).

    Moi khoi la mot file khoi_*.xml, dung chung voi ban may tinh bang o
    layout-sw600dp/activity_main.xml. Sua mot khoi thi ca hai ban cung doi.

    Thu tu tu tren xuong:
        (ke hoach tiep theo) -> y dinh -> cau hoi + o nhap -> THOI GIAN
        -> BUOC (kem Goi y) -> nut chinh + muc nhac -> lich / loi nhac / nhat ky

    Hai khoi thong tin cua phien (thoi gian, buoc) - duoi gioi han ~4 don
    vi tri nho lam viec o UIUX_QUYET_DINH cau 3. Nhan vat dong hanh da bo.
-->
<!--
    Thanh tab nam NGOAI ScrollView: no dung yen o day man hinh, khong
    cuon theo noi dung. Do la cach ba ban thiet ke nhom chot ve no.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:id="@+id/cuon"
    android:layout_weight="1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@color/nen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/le_man_hinh">

        <include layout="@layout/khoi_thanh_tren" />
        <include layout="@layout/khoi_tiep_theo" />
        <include layout="@layout/khoi_y_dinh" />
        <include layout="@layout/khoi_hoi" />
        <include layout="@layout/khoi_thoi_gian" />
        <include layout="@layout/khoi_buoc" />
        <include layout="@layout/khoi_hanh_dong" />
    </LinearLayout>
</ScrollView>

    <include layout="@layout/khoi_tab_duoi" />
</LinearLayout>
