<?xml version="1.0" encoding="utf-8"?>
<!--
    KHOI 2 / 3 - BUOC HIEN TAI.

    Buoc dang lam viet TO o tren. Ben duoi la cac buoc, moi buoc mot
    khoi mau (MainActivity.veCacBuoc). Buoc xong mo di va co dau tich -
    KHONG gach do, khong danh dau "chua xong".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Flowy.The"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Flowy.NhanKhoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/khoi_buoc" />

    <TextView
        android:id="@+id/tv_buoc_hien_tai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/chu"
        android:textSize="@dimen/chu_buoc_hien_tai"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ds_buoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/vien" />

    <!--
        Cau app vua noi (de doc lai neu lo mat vi on) va nut Goi y.

        Nut Goi y THAY cho cu cham vao nhan vat (da bo 16/09). Day van la
        loi moi DUY NHAT de app doc len mot cau hoi - app khong bao gio tu
        bat chuyen. Cau hoi tuy luc: dang ket, bi keo dai, hay vua xong.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cau_noi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:hint="@string/cham_ban_de_hoi"
            android:textColor="@color/chu"
            android:textColorHint="@color/chu_phu"
            android:textSize="15sp" />

        <Button
            android:id="@+id/nut_goi_y"
            style="@style/Flowy.NutPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/goi_y" />
    </LinearLayout>
</LinearLayout>
